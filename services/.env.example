# ============================================================
# RJ Flowers — Backend Environment Variables
# ============================================================

# --- SERVER ---
NODE_ENV=development
PORT=5000

# --- DATABASE (MySQL 8) ---
# Local development
DATABASE_URL="mysql://nursery_user:nursery_secure_pass_2026@localhost:3306/nursery_db"
# Production cPanel (example)
# DATABASE_URL="mysql://rjflowe_dbuser:STRONG_PASSWORD@localhost:3306/rjflowe_nurserydb"

# --- AUTHENTICATION (JWT) ---
JWT_SECRET=change_this_to_a_secure_64_character_random_string_for_access_token
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=change_this_to_a_secure_64_character_random_string_for_refresh_token
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=change_this_to_a_secure_cookie_signing_secret

# --- CORS ---
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- GOOGLE OAUTH 2.0 (Optional) ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- FILE UPLOADS ---
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads
