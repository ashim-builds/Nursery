# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/rjflower/api.rjflowers.com"
PassengerBaseURI "/"
PassengerNodejs "/home/rjflower/nodevenv/api.rjflowers.com/20/bin/node"
PassengerAppType node
PassengerStartupFile app.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# CloudLinux NPROC & Passenger Worker Optimization (Hard-capped process spawning)
PassengerMaxPoolSize 2
PassengerMaxInstances 2
PassengerMinInstances 1
PassengerPoolIdleTime 300
PassengerStatThrottleRate 60

# Block direct browser access to sensitive configuration, secrets, manifests and database dumps
<FilesMatch "^(\.env|\.env\..*|\.git.*|package\.json|package-lock\.json|tsconfig\.json|.*\.sql|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to hidden directories and source files
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env|\.git|node_modules|logs) - [F,L,NC]
    RewriteRule \.(sql|log|ts)$ - [F,L,NC]
</IfModule>

# Environment variables for Passenger
SetEnv DATABASE_URL "mysql://rjflower_rjflowers:Rjflowers%402026!@localhost:3306/rjflower_nurserydb?connection_limit=3&pool_timeout=10"
SetEnv NODE_ENV "production"
SetEnv PORT "5000"
SetEnv JWT_SECRET "20ctA0szmkzihsPnKEJeZoZAa3NaO6mDeo9xvWdEBCp"
SetEnv JWT_REFRESH_SECRET "viHMvaBl1vdFdVIn1It8gSCvrui8yx8eGmEBAkcaXLF"
SetEnv COOKIE_SECRET "XHC2Gt3tgQ994mBfVIcacuAMPy6Ks28Ef23pl7CTGQV"
SetEnv FRONTEND_URL "https://rjflowers.com"
SetEnv BACKEND_URL "https://api.rjflowers.com"
SetEnv CORS_ORIGIN "https://rjflowers.com"


# Global CORS Headers for Apache (guarantees CORS headers even on 5xx error responses)
<IfModule mod_headers.c>
    SetEnvIf Origin "^(https?://(www\.)?rjflowers\.com(:[0-9]+)?|https?://localhost(:[0-9]+)?)$" CORS_ORIGIN=$0
    Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Credentials "true" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, x-session-id, x-refresh-token, Accept, Origin, X-Requested-With, Cache-Control, Pragma, Expires, If-Modified-Since"
</IfModule>

