# ============================================================
# KtmBotanica — Environment Variables Template
# Mobile-First Nursery & Botanical Flowers eCommerce Platform
# ============================================================

# --- SERVER & PORTS ---
NODE_ENV=development
PORT=5000
PORT_HTTP=80
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:5000
CORS_ORIGIN=http://localhost

# --- DATABASE (MySQL 8) ---
# For local Docker: mysql://nursery_user:nursery_secure_pass_2026@mysql:3306/nursery_db
# For production WebPro: mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>
DATABASE_URL="mysql://nursery_user:nursery_secure_pass_2026@mysql:3306/nursery_db"
MYSQL_ROOT_PASSWORD=nursery_root_secure_pass_2026
MYSQL_DATABASE=nursery_db
MYSQL_USER=nursery_user
MYSQL_PASSWORD=nursery_secure_pass_2026

# --- AUTHENTICATION (JWT) ---
JWT_SECRET=change_this_to_a_secure_64_character_random_string_for_access_token
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_a_secure_64_character_random_string_for_refresh_token
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=change_this_to_a_secure_cookie_signing_secret_2026

# --- GOOGLE OAUTH 2.0 ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- STORAGE (NVMe / Local Filesystem — NO Cloudinary) ---
# Local Docker: /app/uploads
# Production WebPro: /home/username/public_html/uploads or custom NVMe mount
UPLOAD_DIR=/app/uploads
UPLOAD_BASE_URL=/uploads

# --- PAYMENT GATEWAYS (Nepal) ---
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
KHALTI_PUBLIC_KEY=test_public_key_ktmbotanica
KHALTI_SECRET_KEY=test_secret_key_ktmbotanica
